# StockNotify — Environment Configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.

# ── Databento ─────────────────────────────────────────────────────────────────
# Get your key at https://databento.com/portal/keys
# Requires the "Standard" plan + "US Equities" add-on for EQUS.MINI
SN_DB_KEY=db-YOUR_DATABENTO_KEY_HERE

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot at https://t.me/BotFather → /newbot
SN_TG_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram chat IDs that receive alerts (JSON dict: {"chat_id": "label"})
# To find your chat ID: message @userinfobot on Telegram
# Channel ID starts with -100..., personal chat ID is a positive integer
SN_TG_CHATS={"YOUR_CHAT_ID": "alerts", "YOUR_CHANNEL_ID": "channel"}

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Port for the web dashboard (default 8436)
# SN_PORT=8436

# ── Storage ───────────────────────────────────────────────────────────────────
# Where to store historical 1-min bar parquet files
# Default: ./data/bars (relative to StockNotify project folder)
# SN_DATA_ROOT=./data/bars
